# sbobctl generated audit rules — workload: redis (SBoB v0.0.4)
# image: docker.io/library/redis@sha256:e508c66a2e1d5d5f8d16b1bbf85e6c1c19b9e5c4c5d1e3f7e5a9d7d0f8e3f4d2
# Mode A (exe-scoped): only the workload's declared executables generate events.

-a always,exit -F arch=b64 -S execve -F exe=/usr/bin/redis-server -k sbob-exec-redis
-a always,exit -F arch=b32 -S execve -F exe=/usr/bin/redis-server -k sbob-exec-redis
-a always,exit -F arch=b64 -S execve -F exe=/bin/sh -k sbob-exec-redis
-a always,exit -F arch=b32 -S execve -F exe=/bin/sh -k sbob-exec-redis

-a always,exit -F arch=b64 -S open,openat -F exe=/usr/bin/redis-server -k sbob-open-redis
-a always,exit -F arch=b64 -S open,openat -F exe=/bin/sh -k sbob-open-redis
-a always,exit -F arch=b64 -S connect -F exe=/usr/bin/redis-server -k sbob-connect-redis
-a always,exit -F arch=b64 -S connect -F exe=/bin/sh -k sbob-connect-redis

# signature-rule syscalls (rulePolicies, TDS 7.4) — node-scoped keys (Mode B):
# every process on the host trips these; exempt legitimate actors via
# rulePolicies.processAllowed (comm list) in the workload SBoBs.
# module-load (init_module,finit_module)
-a always,exit -F arch=b64 -S init_module,finit_module -k sbob-module-load
-a always,exit -F arch=b32 -S init_module,finit_module -k sbob-module-load
# namespace-change (unshare,setns)
-a always,exit -F arch=b64 -S unshare,setns -k sbob-namespace-change
-a always,exit -F arch=b32 -S unshare,setns -k sbob-namespace-change
# process-tracing (ptrace)
-a always,exit -F arch=b64 -S ptrace -k sbob-process-tracing
-a always,exit -F arch=b32 -S ptrace -k sbob-process-tracing
# execution-from-memory (memfd_create)
-a always,exit -F arch=b64 -S memfd_create -k sbob-memfd
-a always,exit -F arch=b32 -S memfd_create -k sbob-memfd
# k8s-node: container exes resolve inside the pod mount namespace (overlayfs),
# so Mode A keys carry the workload identity implicitly (TDS 6.3 tier 2).
# cgroup field: keep auditd >= 3.0 defaults — SYSCALL records then carry cgroup=, enabling tier-1 pod attribution.

