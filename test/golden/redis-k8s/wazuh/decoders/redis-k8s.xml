<!--
  sbob decoders for workload redis — k8s-node target (audit + cgroup attribution)
  workload: redis
  generated by sbobctl (do not edit by hand; regenerate from the pinned SBoB)
  LAB VALIDATED (2026-10-29, wazuh/wazuh-manager:4.14.6): evidence https://github.com/DevelApp-ai/Software-Bill-of-Behavior/actions/runs/40931193214
-->

  <!-- re-declared (NOT modified) to attach the sbob payload children below; the shipped auditd-generic (0040-auditd_decoders.xml) already extracts audit.type/audit.key/audit.command/audit.exe — the old custom sbob root/key/exe chain was preempted by the shipped auditd root and removed (wazuh 4.14.6 lab finding) -->
  <decoder name="auditd-generic">
  </decoder>

  <!-- raw sockaddr hex of SOCKADDR records (AF_INET: family 0200 + port + ip + padding, UPPERCASE); the egress CDB lists key on this byte string (TDS 7.3.1 raw-hex model) -->
  <decoder name="sbob-redis-saddr">
    <parent>auditd-generic</parent>
    <regex>saddr=(\S+)</regex>
    <order>sbob.saddr</order>
  </decoder>

  <!-- PATH record name= payload (opens drift); PATH lines carry no audit key, so the workload scope rides Mode A exe-filtered audit rules (TDS 4.2); paths with embedded spaces are not captured (honest limitation of the tail-join regex) -->
  <decoder name="sbob-redis-path">
    <parent>auditd-generic</parent>
    <regex>name=&quot;([^&quot;\s]+)&quot;</regex>
    <order>sbob.path</order>
  </decoder>

  <!-- command-wodle output from sbob-audit-digest.sh: sha256 of the node's installed sbob audit key set (TDS 10.1) -->
  <decoder name="sbob-redis-config-check">
    <prematch>^sbob-audit-digest: [0-9a-f]{64}</prematch>
    <regex>^sbob-audit-digest: ([0-9a-f]{64})</regex>
    <order>sbob.audit_digest</order>
  </decoder>

  <!-- auditd >= 3.0 emits cgroup= on SYSCALL records; the decoders extract the kubepods pod uid (TDS 6.3 tier 1). Real pod uids are hex UUIDs, not decimal; the three real-world cgroup forms are covered by sibling decoders: cgroup v2/systemd with underscores (pod<uid>.scope), cgroup v2/systemd with dashes (pod<uid>.scope), and cgroup v1 (pod<uid>/). OS_Regex-safe on purpose (decoders default to OS_Regex): no lookaheads, no character classes, no bounded quantifiers — tail-join child of the SHIPPED auditd-generic (the old custom sbob-audit-key chain was preempted by the shipped auditd root, lab finding) -->
  <decoder name="sbob-redis-audit-cgroup">
    <parent>auditd-generic</parent>
    <regex>cgroup=\S*kubepods\S*pod(\w+)\.scope\S*</regex>
    <order>sbob.pod_uid</order>
  </decoder>

  <!-- auditd >= 3.0 emits cgroup= on SYSCALL records; the decoders extract the kubepods pod uid (TDS 6.3 tier 1). Real pod uids are hex UUIDs, not decimal; the three real-world cgroup forms are covered by sibling decoders: cgroup v2/systemd with underscores (pod<uid>.scope), cgroup v2/systemd with dashes (pod<uid>.scope), and cgroup v1 (pod<uid>/). OS_Regex-safe on purpose (decoders default to OS_Regex): no lookaheads, no character classes, no bounded quantifiers — tail-join child of the SHIPPED auditd-generic -->
  <decoder name="sbob-redis-audit-cgroup-dash">
    <parent>auditd-generic</parent>
    <regex>cgroup=\S*kubepods\S*pod(\w+-\w+-\w+-\w+-\w+)\.scope\S*</regex>
    <order>sbob.pod_uid</order>
  </decoder>

  <!-- auditd >= 3.0 emits cgroup= on SYSCALL records; the decoders extract the kubepods pod uid (TDS 6.3 tier 1). Real pod uids are hex UUIDs, not decimal; the three real-world cgroup forms are covered by sibling decoders: cgroup v2/systemd with underscores (pod<uid>.scope), cgroup v2/systemd with dashes (pod<uid>.scope), and cgroup v1 (pod<uid>/). OS_Regex-safe on purpose (decoders default to OS_Regex): no lookaheads, no character classes, no bounded quantifiers — tail-join child of the SHIPPED auditd-generic -->
  <decoder name="sbob-redis-audit-cgroup-v1">
    <parent>auditd-generic</parent>
    <regex>cgroup=\S*kubepods\S*pod(\w+-\w+-\w+-\w+-\w+)/\S*</regex>
    <order>sbob.pod_uid</order>
  </decoder>
