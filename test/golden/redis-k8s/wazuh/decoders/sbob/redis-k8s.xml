<!--
  sbob decoders for workload redis — k8s-node target (config-check digest routing only)
  workload: redis
  generated by sbobctl (do not edit by hand; regenerate from the pinned SBoB)
  LAB VALIDATION PENDING (M3 exit criteria): replay scripts/logtest-corpus.sh k8s corpus on a lab k8s node with a live wazuh manager; auditd events ride the SHIPPED decoder chain (0040-auditd_decoders.xml) — custom audit decoders lose root selection and are not emitted (issue #42 defect 9); audit keys for reference: sbob-exec-redis, sbob-open-redis, sbob-connect-redis
-->

  <!-- command-wodle output from sbob-audit-digest.sh: sha256 of the node's installed sbob audit key set (TDS 10.1) -->
  <decoder name="sbob-redis-config-check">
    <prematch>^sbob-audit-digest: [0-9a-f]{64}</prematch>
    <regex>^sbob-audit-digest: ([0-9a-f]{64})</regex>
    <order>sbob.audit_digest</order>
  </decoder>
