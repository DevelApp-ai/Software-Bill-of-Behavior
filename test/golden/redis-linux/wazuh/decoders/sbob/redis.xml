<!--
  sbob decoders for workload redis — routing on generated audit keys
  workload: redis
  generated by sbobctl (do not edit by hand; regenerate from the pinned SBoB)
  LAB VALIDATED (2026-10-29, wazuh/wazuh-manager:4.14.6): evidence https://github.com/DevelApp-ai/Software-Bill-of-Behavior/actions/runs/40931193214
-->

  <!-- root decoder for sbob-scoped audit events (sbob-exec-redis, sbob-open-redis, sbob-connect-redis) -->
  <decoder name="sbob-redis-audit-root">
    <prematch>\d:type=SYSCALL msg=audit(\d+): arch=\S+ syscall=\S+ </prematch>
  </decoder>

  <decoder name="sbob-redis-audit-key">
    <parent>sbob-redis-audit-root</parent>
    <regex>key=&quot;(\S+)&quot;</regex>
    <order>sbob.key</order>
  </decoder>

  <decoder name="sbob-redis-audit-exe">
    <parent>sbob-redis-audit-key</parent>
    <regex>exe=&quot;(\S+)&quot;</regex>
    <order>sbob.exe</order>
  </decoder>

  <decoder name="sbob-redis-audit-comm">
    <parent>sbob-redis-audit-key</parent>
    <regex>comm=&quot;(\S+)&quot;</regex>
    <order>sbob.comm</order>
  </decoder>

  <!-- raw sockaddr; hex AF_INET decode to sbob.dst_ip/sbob.dst_port is the saddr work item (TDS 7.3.1) -->
  <decoder name="sbob-redis-audit-saddr">
    <parent>sbob-redis-audit-key</parent>
    <regex>saddr=(\S+)</regex>
    <order>sbob.saddr</order>
  </decoder>

  <!-- PATH records (opens drift); workload scoping relies on Mode A exe-filtered audit rules -->
  <decoder name="sbob-redis-path-root">
    <prematch>\d:type=PATH msg=audit(\d+): item=\d+ name=</prematch>
  </decoder>

  <decoder name="sbob-redis-path-name">
    <parent>sbob-redis-path-root</parent>
    <regex>name=&quot;(\S+)&quot;</regex>
    <order>sbob.path</order>
  </decoder>

  <!-- command-wodle output from sbob-audit-digest.sh: sha256 of the node's installed sbob audit key set (TDS 10.1) -->
  <decoder name="sbob-redis-config-check">
    <prematch>^sbob-audit-digest: [0-9a-f]{64}</prematch>
    <regex>^sbob-audit-digest: ([0-9a-f]{64})</regex>
    <order>sbob.audit_digest</order>
  </decoder>
