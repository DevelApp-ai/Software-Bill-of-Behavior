<!--
  sbob drift rules for workload redis — Linux / k8s-node target
  workload: redis
  generated by sbobctl (do not edit by hand; regenerate from the pinned SBoB)
  LAB VALIDATION PENDING (M1 exit criteria): run scripts/logtest-corpus.sh against a lab node with a live wazuh manager
-->

  <rule id="100000" level="0">
    <if_group>auditd</if_group>
    <field name="sbob.key">^sbob-exec(?:-redis)?$</field>
    <group>sbob,redis,sbob-exec</group>
    <description>SBoB base: exec event on sbob scope (redis)</description>
  </rule>

  <!-- level-0 base child that carries the section group; drift rules chain from here -->
  <rule id="100010" level="0">
    <if_sid>100000</if_sid>
    <group>sbob,redis,sbob-exec</group>
    <description>SBoB base: exec base for workload redis</description>
  </rule>

  <rule id="100011" level="9">
    <if_sid>100010</if_sid>
    <list field="sbob.exe" lookup="not_match_key">sbob/redis/execs</list>
    <group>sbob,redis,sbob-drift,process-execution</group>
    <mitre><id>T1059</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: process $(sbob.exe) not declared in execs[] of redis SBoB v0.0.4 (image docker.io/library/redis@sha256:e508c66a2e1d5d5f8d16b1bbf85e6c1c19b9e5c4c5d1e3f7e5a9d7d0f8e3f4d2)</description>
  </rule>

  <rule id="100012" level="12">
    <if_sid>100011</if_sid>
    <frequency>8</frequency>
    <timeframe>120</timeframe>
    <group>sbob,redis,sbob-drift,process-execution,sustained</group>
    <description>SBoB sustained drift: repeated undeclared process execution on redis (8 in 120s)</description>
  </rule>

  <!-- matches type=PATH records; workload scoping via Mode A exe-filtered audit rules -->
  <rule id="100020" level="0">
    <if_group>auditd</if_group>
    <field name="sbob.path">^/.+$</field>
    <group>sbob,redis,sbob-open</group>
    <description>SBoB base: PATH record observed (opens scope redis)</description>
  </rule>

  <!-- path-level drift; flag-level (O_*) child rules are deferred per TDS 6.4 -->
  <rule id="100021" level="9">
    <if_sid>100020</if_sid>
    <field name="sbob.path">^(?!(?:/data/[^/]+(?:/[^/]+)*)$)</field>
    <list field="sbob.path" lookup="not_match_key">sbob/redis/opens</list>
    <group>sbob,redis,sbob-drift,file-access</group>
    <mitre><id>T1005</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: file open $(sbob.path) not declared in opens[] of redis SBoB v0.0.4</description>
  </rule>

  <rule id="100022" level="12">
    <if_sid>100021</if_sid>
    <frequency>8</frequency>
    <timeframe>120</timeframe>
    <group>sbob,redis,sbob-drift,file-access,sustained</group>
    <description>SBoB sustained drift: repeated undeclared file opens on redis (8 in 120s)</description>
  </rule>

  <rule id="100030" level="0">
    <if_group>auditd</if_group>
    <field name="sbob.key">^sbob-connect(?:-redis)?$</field>
    <group>sbob,redis,sbob-connect</group>
    <description>SBoB base: outbound connect observed (redis)</description>
  </rule>

  <!-- fires when the saddr decoder (TDS 7.3.1) emits sbob.dst_ip/sbob.dst_port;  -->
  <rule id="100031" level="9">
    <if_sid>100030</if_sid>
    <field name="sbob.dst_port">^(?!(?:53|443)$)</field>
    <list field="sbob.dst_ip" lookup="not_address_match_key">sbob/redis/egress_addrs</list>
    <group>sbob,redis,sbob-drift,egress-traffic</group>
    <mitre><id>T1071</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: connect to $(sbob.dst_ip):$(sbob.dst_port) not declared in egress[] of redis SBoB v0.0.4</description>
  </rule>

  <rule id="100032" level="12">
    <if_sid>100031</if_sid>
    <frequency>8</frequency>
    <timeframe>120</timeframe>
    <group>sbob,redis,sbob-drift,egress-traffic,sustained</group>
    <description>SBoB sustained drift: repeated undeclared egress on redis (8 in 120s)</description>
  </rule>

  <rule id="100043" level="3">
    <if_group>auditd</if_group>
    <field name="sbob.key">^sbob-accept(?:-redis)?$</field>
    <group>sbob,redis,sbob-info,ingress-traffic</group>
    <description>SBoB informational: ingress[] declared for redis but Linux accept() telemetry cannot attribute peers; host-firewall ingestion required (TDS 8)</description>
  </rule>
