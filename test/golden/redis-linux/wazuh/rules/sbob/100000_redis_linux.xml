<!--
  sbob drift + signature + ops rules for workload redis — Linux / k8s-node target (wazuh 4.14 schema, issue #42)
  workload: redis
  generated by sbobctl (do not edit by hand; regenerate from the pinned SBoB)
  LAB VALIDATION PENDING (M1 exit criteria): run scripts/logtest-corpus.sh against a lab node with a live wazuh manager
-->

<group name="sbob,redis">
  <!-- shipped auditd decoder family + group 'audit' (0365 et al); Mode A keys carry the workload identity -->
  <rule  id="100000" level="0">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^sbob-exec(?:-redis)?$</field>
    <group>sbob,redis,sbob-exec</group>
    <description>SBoB base: exec event on sbob scope (redis)</description>
  </rule>

  <!-- CDB exact keys + PCRE2 negation for wildcard entries, both on the shipped audit.exe field -->
  <rule  id="100011" level="9">
    <if_sid>100000</if_sid>
    <list field="audit.exe" lookup="not_match_key">etc/lists/sbob/redis/execs</list>
    <group>sbob,redis,sbob-drift,process-execution</group>
    <mitre><id>T1059</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: process $(audit.exe) not declared in execs[] of redis SBoB v0.0.4 (image docker.io/library/redis@sha256:e508c66a2e1d5d5f8d16b1bbf85e6c1c19b9e5c4c5d1e3f7e5a9d7d0f8e3f4d2)</description>
  </rule>

  <!-- if_matched_sid + same_field correlation (an empty same_field never correlates on wazuh 4.14). Note: the correlation context only accumulates while this rule's PARENT wins the matched-rule selection — when a higher-level signature overlay (e.g. (0,1) sensitive-file, level 12) wins the event, repetition is escalated by the (0,9) sustained-signature child instead (issue #42) -->
  <rule  id="100012" level="13" frequency="8" timeframe="120">
    <if_matched_sid>100011</if_matched_sid>
    <same_field>audit.exe</same_field>
    <group>sbob,redis,sbob-drift,process-execution,sustained</group>
    <description>SBoB sustained drift: repeated undeclared process execution on redis (8 in 120s)</description>
  </rule>

  <!-- modes base on the ROUTE (record type + a quoted name), not the audit key: auditd interleaves the key only on the SYSCALL line; workload scoping via Mode A exe-filtered audit rules -->
  <rule  id="100020" level="0">
    <if_group>audit</if_group>
    <field name="audit.type" type="pcre2">^PATH$</field>
    <field name="audit.directory.name" type="pcre2">^"[^"]+"$</field>
    <group>sbob,redis,sbob-open</group>
    <description>SBoB base: PATH record observed (opens scope redis)</description>
  </rule>

  <!-- quote-anchored negation — audit.directory.name decodes WITH its quotes; no CDB list (quoted keys are fragile) -->
  <rule  id="100021" level="9">
    <if_sid>100020</if_sid>
    <field name="audit.directory.name" type="pcre2">^"(?!/etc/resolv\.conf"$|/data/[^/"]+(?:/[^/"]+)*"$)[^"]+"$</field>
    <group>sbob,redis,sbob-drift,file-access</group>
    <mitre><id>T1005</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: file open $(audit.directory.name) not declared in opens[] of redis SBoB v0.0.4</description>
  </rule>

  <!-- if_matched_sid + same_field correlation (an empty same_field never correlates on wazuh 4.14). Note: the correlation context only accumulates while this rule's PARENT wins the matched-rule selection — when a higher-level signature overlay (e.g. (0,1) sensitive-file, level 12) wins the event, repetition is escalated by the (0,9) sustained-signature child instead (issue #42) -->
  <rule  id="100022" level="13" frequency="8" timeframe="120">
    <if_matched_sid>100021</if_matched_sid>
    <same_field>audit.directory.name</same_field>
    <group>sbob,redis,sbob-drift,file-access,sustained</group>
    <description>SBoB sustained drift: repeated undeclared file opens on redis (8 in 120s)</description>
  </rule>

  <!-- SOCKADDR records decode saddr= hex into the STATIC srcip field (shipped auditd family) -->
  <rule  id="100030" level="0">
    <if_group>audit</if_group>
    <field name="audit.type" type="pcre2">^SOCKADDR$</field>
    <group>sbob,redis,sbob-connect</group>
    <description>SBoB base: outbound SOCKADDR observed (redis)</description>
  </rule>

  <!-- CDB on the STATIC srcip field (PCRE2 conditions on static fields are rejected by analysisd; list lookups on static fields ARE allowed). The list keys are the saddr hex spellings (both padded + truncated) of the declared ip:port peers.  -->
  <rule  id="100031" level="9">
    <if_sid>100030</if_sid>
    <list field="srcip" lookup="not_match_key">etc/lists/sbob/redis/egress_saddrs</list>
    <group>sbob,redis,sbob-drift,egress-traffic</group>
    <mitre><id>T1071</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: connect to $(srcip) not declared in egress[] of redis SBoB v0.0.4</description>
  </rule>

  <!-- if_matched_sid + same_field correlation (an empty same_field never correlates on wazuh 4.14). Note: the correlation context only accumulates while this rule's PARENT wins the matched-rule selection — when a higher-level signature overlay (e.g. (0,1) sensitive-file, level 12) wins the event, repetition is escalated by the (0,9) sustained-signature child instead (issue #42) -->
  <rule  id="100032" level="13" frequency="8" timeframe="120">
    <if_matched_sid>100031</if_matched_sid>
    <same_srcip />
    <group>sbob,redis,sbob-drift,egress-traffic,sustained</group>
    <description>SBoB sustained drift: repeated undeclared egress on redis (8 in 120s)</description>
  </rule>

  <rule  id="100043" level="3">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^sbob-accept(?:-redis)?$</field>
    <group>sbob,redis,sbob-info,ingress-traffic</group>
    <description>SBoB informational: ingress[] declared for redis but Linux accept() telemetry cannot attribute peers; host-firewall ingestion required (TDS 8)</description>
  </rule>

  <!-- node-scoped key (Mode B): fires for any process riding the shipped auditd decoder family under the shipped 'audit' group — k8s attribution relies on Mode A exe-scoped keys (tier 2); tier-1 cgroup attribution is INERT on wazuh 4.14.6 (the shipped auditd family preempts custom audit roots). Fires by default — exemptions via rulePolicies.processAllowed (audit.command CDB) -->
  <rule  id="100060" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^sbob-module-load$</field>
    <group>sbob,redis,sbob-sig-module-load</group>
    <group>sbob,redis,sbob-signature</group>
    <mitre><id>T1547.006</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: kernel module load on redis scope (module-load policy, TDS 7.4) — comm $(audit.command), exe $(audit.exe)</description>
  </rule>

  <!-- node-scoped key (Mode B): fires for any process riding the shipped auditd decoder family under the shipped 'audit' group — k8s attribution relies on Mode A exe-scoped keys (tier 2); tier-1 cgroup attribution is INERT on wazuh 4.14.6 (the shipped auditd family preempts custom audit roots). Fires by default — exemptions via rulePolicies.processAllowed (audit.command CDB) -->
  <rule  id="100061" level="10">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^sbob-namespace-change$</field>
    <group>sbob,redis,sbob-sig-namespace-change</group>
    <group>sbob,redis,sbob-signature</group>
    <mitre><id>T1611</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: namespace change (unshare/setns) on redis scope (namespace-change policy, TDS 7.4) — comm $(audit.command), exe $(audit.exe)</description>
  </rule>

  <!-- node-scoped key (Mode B): fires for any process riding the shipped auditd decoder family under the shipped 'audit' group — k8s attribution relies on Mode A exe-scoped keys (tier 2); tier-1 cgroup attribution is INERT on wazuh 4.14.6 (the shipped auditd family preempts custom audit roots). Fires by default — exemptions via rulePolicies.processAllowed (audit.command CDB) -->
  <rule  id="100062" level="10">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^sbob-process-tracing$</field>
    <group>sbob,redis,sbob-sig-process-tracing</group>
    <group>sbob,redis,sbob-signature</group>
    <mitre><id>T1055.008</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: ptrace on redis scope (process-tracing policy, TDS 7.4) — comm $(audit.command), exe $(audit.exe)</description>
  </rule>

  <!-- node-scoped key (Mode B): fires for any process riding the shipped auditd decoder family under the shipped 'audit' group — k8s attribution relies on Mode A exe-scoped keys (tier 2); tier-1 cgroup attribution is INERT on wazuh 4.14.6 (the shipped auditd family preempts custom audit roots). Fires by default — exemptions via rulePolicies.processAllowed (audit.command CDB) -->
  <rule  id="100063" level="10">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^sbob-memfd$</field>
    <group>sbob,redis,sbob-sig-execution-from-memory</group>
    <group>sbob,redis,sbob-signature</group>
    <mitre><id>T1620</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: memfd_create (fileless execution) on redis scope (execution-from-memory policy, TDS 7.4) — comm $(audit.command), exe $(audit.exe)</description>
  </rule>

  <!-- severity-raising overlay on the opens drift rule; watchlist per TDS 7.4, quote-anchored (audit.directory.name carries its quotes) -->
  <rule  id="100001" level="12">
    <if_sid>100021</if_sid>
    <field name="audit.directory.name" type="pcre2">^"(?:/etc/(?:shadow|gshadow|sudoers)(?:\.d/[^"]+)?|/root/\.ssh/[^"]+|/home/[^/]+/\.ssh/[^"]+|/etc/ssh/[^"]*_key[^"]*|[^"]*/id_(?:rsa|ed25519|ecdsa)(?:\.pub)?)"$</field>
    <group>sbob,redis,sbob-sig-sensitive-file-access</group>
    <group>sbob,redis,sbob-signature,file-access</group>
    <mitre><id>T1552.001</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: sensitive file $(audit.directory.name) accessed (sensitive-file-access policy, TDS 7.4)</description>
  </rule>

  <!-- chains off the overlay (0,1), not the drift parent: wazuh 4.14 correlation context accumulates only while the parent rule WINS the matched-rule selection, and the level-12 overlay always outscores the level-9 drift rule; the drift-parent variant (2,2) covers non-sensitive repetition -->
  <rule  id="100009" level="13" frequency="8" timeframe="120">
    <if_matched_sid>100001</if_matched_sid>
    <same_field>audit.directory.name</same_field>
    <group>sbob,redis,sbob-sig-sensitive-file-access</group>
    <group>sbob,redis,sbob-signature,file-access,sustained</group>
    <options>no_full_log</options>
    <description>SBoB sustained signature: repeated sensitive-file access $(audit.directory.name) on redis (8 in 120s) — sustained exfil pattern (sensitive-file-access policy, TDS 7.4)</description>
  </rule>

  <!-- k8s projected SA volume; chain with kubernetes-api-access alerts for credential misuse (TDS 7.4) -->
  <rule  id="100002" level="12">
    <if_sid>100021</if_sid>
    <field name="audit.directory.name" type="pcre2">^"/var/run/secrets/kubernetes\.io/serviceaccount/(?:token|ca\.crt|namespace)"$</field>
    <group>sbob,redis,sbob-sig-sa-token-access</group>
    <group>sbob,redis,sbob-signature,credential-access</group>
    <mitre><id>T1552.001</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: service-account token material $(audit.directory.name) read (service-account-token-access policy, TDS 7.4)</description>
  </rule>

  <!-- fires from the command-wodle digest line when the node's installed sbob audit keys differ from the bundle (audit rules are not hot-reloadable; node rollout required) -->
  <rule  id="100083" level="5">
    <field name="sbob.audit_digest" type="pcre2">^(?!eab7dc5916702b5dcd22632cf9b9a27998a5d2e2fa6b658ea89c36c01a23ea4f$)</field>
    <group>sbob,redis,sbob-ops</group>
    <description>SBoB ops: node sbob audit key set does not match the redis bundle (config-check, TDS 10.1) — audit.rules rollout required on this node; expected key-set digest eab7dc591670…</description>
  </rule>
</group>
