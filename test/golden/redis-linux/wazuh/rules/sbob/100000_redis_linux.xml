<!--
  sbob drift + signature + ops rules for workload redis — Linux / k8s-node target
  workload: redis
  generated by sbobctl (do not edit by hand; regenerate from the pinned SBoB)
  LAB VALIDATION PENDING (M1 exit criteria): run scripts/logtest-corpus.sh against a lab node with a live wazuh manager
-->

  <rule id="100000" level="0">
    <if_group>auditd</if_group>
    <field name="sbob.key" type="pcre2">^sbob-exec(?:-redis)?$</field>
    <group>sbob,redis,sbob-exec</group>
    <description>SBoB base: exec event on sbob scope (redis)</description>
  </rule>

  <!-- level-0 base child that carries the section group; drift rules chain from here -->
  <rule id="100010" level="0">
    <if_sid>100000</if_sid>
    <group>sbob,redis,sbob-exec</group>
    <description>SBoB base: exec base for workload redis</description>
  </rule>

  <rule id="100011" level="9">
    <if_sid>100010</if_sid>
    <list field="sbob.exe" lookup="not_match_key">sbob/redis/execs</list>
    <group>sbob,redis,sbob-drift,process-execution</group>
    <mitre><id>T1059</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: process $(sbob.exe) not declared in execs[] of redis SBoB v0.0.4 (image docker.io/library/redis@sha256:e508c66a2e1d5d5f8d16b1bbf85e6c1c19b9e5c4c5d1e3f7e5a9d7d0f8e3f4d2)</description>
  </rule>

  <rule id="100012" level="12">
    <if_sid>100011</if_sid>
    <frequency>8</frequency>
    <timeframe>120</timeframe>
    <group>sbob,redis,sbob-drift,process-execution,sustained</group>
    <description>SBoB sustained drift: repeated undeclared process execution on redis (8 in 120s)</description>
  </rule>

  <!-- matches type=PATH records; workload scoping via Mode A exe-filtered audit rules -->
  <rule id="100020" level="0">
    <if_group>auditd</if_group>
    <field name="sbob.path" type="pcre2">^/.+$</field>
    <group>sbob,redis,sbob-open</group>
    <description>SBoB base: PATH record observed (opens scope redis)</description>
  </rule>

  <!-- path-level drift; flag-level (O_*) child rules are deferred per TDS 6.4 -->
  <rule id="100021" level="9">
    <if_sid>100020</if_sid>
    <field name="sbob.path" type="pcre2">^(?!(?:/data/[^/]+(?:/[^/]+)*)$)</field>
    <list field="sbob.path" lookup="not_match_key">sbob/redis/opens</list>
    <group>sbob,redis,sbob-drift,file-access</group>
    <mitre><id>T1005</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: file open $(sbob.path) not declared in opens[] of redis SBoB v0.0.4</description>
  </rule>

  <rule id="100022" level="12">
    <if_sid>100021</if_sid>
    <frequency>8</frequency>
    <timeframe>120</timeframe>
    <group>sbob,redis,sbob-drift,file-access,sustained</group>
    <description>SBoB sustained drift: repeated undeclared file opens on redis (8 in 120s)</description>
  </rule>

  <rule id="100030" level="0">
    <if_group>auditd</if_group>
    <field name="sbob.key" type="pcre2">^sbob-connect(?:-redis)?$</field>
    <group>sbob,redis,sbob-connect</group>
    <description>SBoB base: outbound connect observed (redis)</description>
  </rule>

  <!-- fires when the saddr decoder (TDS 7.3.1) emits sbob.dst_ip/sbob.dst_port;  -->
  <rule id="100031" level="9">
    <if_sid>100030</if_sid>
    <field name="sbob.dst_port" type="pcre2">^(?!(?:53|443)$)</field>
    <list field="sbob.dst_ip" lookup="not_address_match_key">sbob/redis/egress_addrs</list>
    <group>sbob,redis,sbob-drift,egress-traffic</group>
    <mitre><id>T1071</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: connect to $(sbob.dst_ip):$(sbob.dst_port) not declared in egress[] of redis SBoB v0.0.4</description>
  </rule>

  <rule id="100032" level="12">
    <if_sid>100031</if_sid>
    <frequency>8</frequency>
    <timeframe>120</timeframe>
    <group>sbob,redis,sbob-drift,egress-traffic,sustained</group>
    <description>SBoB sustained drift: repeated undeclared egress on redis (8 in 120s)</description>
  </rule>

  <rule id="100043" level="3">
    <if_group>auditd</if_group>
    <field name="sbob.key" type="pcre2">^sbob-accept(?:-redis)?$</field>
    <group>sbob,redis,sbob-info,ingress-traffic</group>
    <description>SBoB informational: ingress[] declared for redis but Linux accept() telemetry cannot attribute peers; host-firewall ingestion required (TDS 8)</description>
  </rule>

  <!-- node-scoped key (Mode B): fires for any process; on k8s nodes the cgroup decoders stamp sbob.pod_uid for attribution. Fires by default — exemptions via rulePolicies.processAllowed (TDS 6.2) -->
  <rule id="100060" level="12">
    <if_group>auditd</if_group>
    <field name="sbob.key" type="pcre2">^sbob-module-load$</field>
    <group>sbob,redis,sbob-sig-module-load</group>
    <group>sbob,redis,sbob-signature</group>
    <mitre><id>T1547.006</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: kernel module load on redis scope (module-load policy, TDS 7.4) — comm $(sbob.comm), exe $(sbob.exe)</description>
  </rule>

  <!-- node-scoped key (Mode B): fires for any process; on k8s nodes the cgroup decoders stamp sbob.pod_uid for attribution. Fires by default — exemptions via rulePolicies.processAllowed (TDS 6.2) -->
  <rule id="100061" level="10">
    <if_group>auditd</if_group>
    <field name="sbob.key" type="pcre2">^sbob-namespace-change$</field>
    <group>sbob,redis,sbob-sig-namespace-change</group>
    <group>sbob,redis,sbob-signature</group>
    <mitre><id>T1611</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: namespace change (unshare/setns) on redis scope (namespace-change policy, TDS 7.4) — comm $(sbob.comm), exe $(sbob.exe)</description>
  </rule>

  <!-- node-scoped key (Mode B): fires for any process; on k8s nodes the cgroup decoders stamp sbob.pod_uid for attribution. Fires by default — exemptions via rulePolicies.processAllowed (TDS 6.2) -->
  <rule id="100062" level="10">
    <if_group>auditd</if_group>
    <field name="sbob.key" type="pcre2">^sbob-process-tracing$</field>
    <group>sbob,redis,sbob-sig-process-tracing</group>
    <group>sbob,redis,sbob-signature</group>
    <mitre><id>T1055.008</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: ptrace on redis scope (process-tracing policy, TDS 7.4) — comm $(sbob.comm), exe $(sbob.exe)</description>
  </rule>

  <!-- node-scoped key (Mode B): fires for any process; on k8s nodes the cgroup decoders stamp sbob.pod_uid for attribution. Fires by default — exemptions via rulePolicies.processAllowed (TDS 6.2) -->
  <rule id="100063" level="10">
    <if_group>auditd</if_group>
    <field name="sbob.key" type="pcre2">^sbob-memfd$</field>
    <group>sbob,redis,sbob-sig-execution-from-memory</group>
    <group>sbob,redis,sbob-signature</group>
    <mitre><id>T1620</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: memfd_create (fileless execution) on redis scope (execution-from-memory policy, TDS 7.4) — comm $(sbob.comm), exe $(sbob.exe)</description>
  </rule>

  <!-- severity-raising overlay on the opens drift rule; watchlist per TDS 7.4 -->
  <rule id="100001" level="12">
    <if_sid>100021</if_sid>
    <field name="sbob.path" type="pcre2">^(?:/etc/(?:shadow|gshadow|sudoers)(?:\.d/\S+)?|/root/\.ssh/\S+|/home/[^/]+/\.ssh/\S+|/etc/ssh/\S+_key\S*|\S*/id_(?:rsa|ed25519|ecdsa)(?:\.pub)?)$</field>
    <group>sbob,redis,sbob-sig-sensitive-file-access</group>
    <group>sbob,redis,sbob-signature,file-access</group>
    <mitre><id>T1552.001</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: sensitive file $(sbob.path) accessed (sensitive-file-access policy, TDS 7.4)</description>
  </rule>

  <!-- k8s projected SA volume; chain with kubernetes-api-access alerts for credential misuse (TDS 7.4) -->
  <rule id="100002" level="12">
    <if_sid>100021</if_sid>
    <field name="sbob.path" type="pcre2">^/var/run/secrets/kubernetes\.io/serviceaccount/(?:token|ca\.crt|namespace)$</field>
    <group>sbob,redis,sbob-sig-sa-token-access</group>
    <group>sbob,redis,sbob-signature,credential-access</group>
    <mitre><id>T1552.001</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: service-account token material $(sbob.path) read (service-account-token-access policy, TDS 7.4)</description>
  </rule>

  <!-- default kubeadm service CIDR 10.96.0.0/12 (API server VIP); cluster-specific CIDR is an M5 deploy-repo knob. Manager-side k8s audit-log rule for this policy lands with the k8s-node target (TDS 4.4) -->
  <rule id="100003" level="12">
    <if_sid>100031</if_sid>
    <field name="sbob.dst_ip" type="pcre2">^10\.(?:9[6-9]|10[0-9]|11[01])\.[0-9]{1,3}\.[0-9]{1,3}$</field>
    <group>sbob,redis,sbob-sig-kubernetes-api-access</group>
    <group>sbob,redis,sbob-signature,egress-traffic</group>
    <mitre><id>T1613</id></mitre>
    <options>no_full_log</options>
    <description>SBoB signature: undeclared connect into the k8s service CIDR $(sbob.dst_ip) (kubernetes-api-access policy, TDS 7.4)</description>
  </rule>

  <!-- fires from the command-wodle digest line when the node's installed sbob audit keys differ from the bundle (audit rules are not hot-reloadable; node rollout required) -->
  <rule id="100083" level="5">
    <field name="sbob.audit_digest" type="pcre2">^(?!eab7dc5916702b5dcd22632cf9b9a27998a5d2e2fa6b658ea89c36c01a23ea4f$)</field>
    <group>sbob,redis,sbob-ops</group>
    <description>SBoB ops: node sbob audit key set does not match the redis bundle (config-check, TDS 10.1) — audit.rules rollout required on this node; expected key-set digest eab7dc591670…</description>
  </rule>
