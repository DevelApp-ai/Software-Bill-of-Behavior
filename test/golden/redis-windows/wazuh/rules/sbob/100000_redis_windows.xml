<!--
  sbob drift rules for workload redis — Windows / Sysmon target
  workload: redis
  generated by sbobctl (do not edit by hand; regenerate from the pinned SBoB)
  LAB VALIDATION PENDING (M2 exit criteria): replay scripts/logtest-corpus.sh corpus on a lab Windows host with Sysmon and a live wazuh manager
-->

  <!-- requires the shipped ruleset entry rule 61600 (0595-win-sysmon_rules.xml) to be loaded by the manager -->
  <rule id="100005" level="0">
    <if_sid>61600</if_sid>
    <group>sbob,redis,sbob-win</group>
    <description>SBoB base: Sysmon eventchannel event in sbob scope (redis)</description>
  </rule>

  <rule id="100015" level="0">
    <if_sid>100005</if_sid>
    <field name="win.system.eventID" type="pcre2">^1$</field>
    <group>sbob,redis,sbob-exec,sysmon_event1</group>
    <description>SBoB base: Sysmon EID 1 process create on sbob scope (redis)</description>
  </rule>

  <!-- allowlist compiled from the identical IR (TDS 7.2); PCRE2 alternation instead of CDB (drive-letter ':' is the CDB key separator) -->
  <rule id="100016" level="9">
    <if_sid>100015</if_sid>
    <field name="win.eventdata.image" type="pcre2">^(?!(?:/usr/bin/redis-server|/bin/sh)$)</field>
    <group>sbob,redis,sbob-drift,process-execution</group>
    <mitre><id>T1059</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: process image $(win.eventdata.image) not declared in execs[] of redis SBoB v0.0.4 (image docker.io/library/redis@sha256:e508c66a2e1d5d5f8d16b1bbf85e6c1c19b9e5c4c5d1e3f7e5a9d7d0f8e3f4d2)</description>
  </rule>

  <rule id="100017" level="12">
    <if_sid>100016</if_sid>
    <frequency>8</frequency>
    <timeframe>120</timeframe>
    <group>sbob,redis,sbob-drift,process-execution,sustained</group>
    <description>SBoB sustained drift: repeated undeclared process execution on redis (8 in 120s)</description>
  </rule>

  <!-- token-aware command-line heuristic (TDS 7.3.4): Sysmon EID 1 carries CommandLine (one string), not argv; quoting variants are tolerated, argv[0] is anchored at string start — flagged partial in the coverage manifest -->
  <rule id="100006" level="9">
    <if_sid>100015</if_sid>
    <field name="win.eventdata.image" type="pcre2">^(?:/usr/bin/redis-server|/bin/sh)$</field>
    <field name="win.eventdata.commandLine" type="pcre2">^(?!(?:&quot;?/usr/bin/redis-server&quot;?(?:\s.*)?|&quot;?/bin/sh&quot;?\s+(?:&quot;[^&quot;]*&quot;|\S+))$)</field>
    <group>sbob,redis,sbob-drift,process-execution,args-drift</group>
    <mitre><id>T1059</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: declared process $(win.eventdata.image) launched with arguments not declared in execs[].args of redis SBoB v0.0.4</description>
  </rule>

  <rule id="100025" level="0">
    <if_sid>100005</if_sid>
    <field name="win.system.eventID" type="pcre2">^11$</field>
    <group>sbob,redis,sbob-open,sysmon_event_11</group>
    <description>SBoB base: Sysmon EID 11 file create observed on sbob scope (redis)</description>
  </rule>

  <!-- path-level drift from EID 11 targetFilename; opens[].flags are NOT evaluated on Windows — Sysmon reports CreateFile-style events only (coverage partial, TDS 8.2) -->
  <rule id="100026" level="9">
    <if_sid>100025</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">^(?!(?:/data/[^/]+(?:/[^/]+)*|/etc/resolv\.conf)$)</field>
    <group>sbob,redis,sbob-drift,file-access</group>
    <mitre><id>T1005</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: file target $(win.eventdata.targetFilename) not declared in opens[] of redis SBoB v0.0.4</description>
  </rule>

  <rule id="100027" level="12">
    <if_sid>100026</if_sid>
    <frequency>8</frequency>
    <timeframe>120</timeframe>
    <group>sbob,redis,sbob-drift,file-access,sustained</group>
    <description>SBoB sustained drift: repeated undeclared file creates on redis (8 in 120s)</description>
  </rule>

  <!-- Initiated=true scopes the rule to outbound connections; inbound listeners are host-firewall territory (TDS 8.3) -->
  <rule id="100035" level="0">
    <if_sid>100005</if_sid>
    <field name="win.system.eventID" type="pcre2">^3$</field>
    <field name="win.eventdata.initiated" type="pcre2">^[Tt]rue$</field>
    <group>sbob,redis,sbob-connect,sysmon_event3</group>
    <description>SBoB base: Sysmon EID 3 outbound connection observed (redis)</description>
  </rule>

  <!-- k8sPeer entries remain partial (TDS 6.3) -->
  <rule id="100036" level="9">
    <if_sid>100035</if_sid>
    <field name="win.eventdata.destinationPort" type="pcre2">^(?!(?:53|443)$)</field>
    <list field="win.eventdata.destinationIp" lookup="not_address_match_key">sbob/redis/egress_addrs</list>
    <group>sbob,redis,sbob-drift,egress-traffic</group>
    <mitre><id>T1071</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: outbound connection to $(win.eventdata.destinationIp):$(win.eventdata.destinationPort) not declared in egress[] of redis SBoB v0.0.4</description>
  </rule>

  <rule id="100037" level="12">
    <if_sid>100036</if_sid>
    <frequency>8</frequency>
    <timeframe>120</timeframe>
    <group>sbob,redis,sbob-drift,egress-traffic,sustained</group>
    <description>SBoB sustained drift: repeated undeclared egress on redis (8 in 120s)</description>
  </rule>

  <!-- the shipped ruleset routes EIDs 1-15 only, so the EID 22 condition is self-defined here (0595-win-sysmon_rules.xml carries no 22); DNS wildcards never use CDB — byte-exact keys are only valid for plain FQDN entries (TDS 7.2) -->
  <rule id="100007" level="9">
    <if_sid>100005</if_sid>
    <field name="win.system.eventID" type="pcre2">^22$</field>
    <field name="win.eventdata.queryName" type="pcre2">^(?!(?:[^.]+\.api\.stripe\.com)$)</field>
    <group>sbob,redis,sbob-drift,egress-traffic,dns-query</group>
    <mitre><id>T1071</id></mitre>
    <options>no_full_log</options>
    <description>SBoB drift: DNS query for $(win.eventdata.queryName) not declared in egress[].dnsNames of redis SBoB v0.0.4</description>
  </rule>

  <rule id="100048" level="3">
    <if_sid>100005</if_sid>
    <field name="win.system.eventID" type="pcre2">^3$</field>
    <field name="win.eventdata.initiated" type="pcre2">^[Ff]alse$</field>
    <group>sbob,redis,sbob-info,ingress-traffic</group>
    <description>SBoB informational: ingress[] declared for redis but listener-side enforcement is host-firewall territory (TDS 8.3)</description>
  </rule>

  <!-- EID 4 (service state change) is a health signal; agents entirely lacking Sysmon emit no Sysmon events and must be caught by the inventory check -->
  <rule id="100008" level="2">
    <if_sid>100005</if_sid>
    <field name="win.system.eventID" type="pcre2">^4$</field>
    <group>sbob,redis,sbob-info,sysmon-prereq</group>
    <description>SBoB informational: Sysmon service state changed on an agent in the sbob-redis scope — verify the deployment prerequisite (TDS 4.3, M5 runbook inventory check)</description>
  </rule>
